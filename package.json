{
  "name": "shulker",
  "version": "0.1.0",
  "description": "Explore your disk and review cleanup candidates on Windows, macOS, and Linux.",
  "keywords": [
    "macos",
    "linux",
    "disk",
    "storage",
    "disk-usage",
    "cleanup",
    "cache",
    "tui",
    "terminal",
    "cli",
    "du",
    "node_modules"
  ],
  "homepage": "https://github.com/ykalani/shulker#readme",
  "bugs": {
    "url": "https://github.com/ykalani/shulker/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ykalani/shulker.git"
  },
  "license": "MIT",
  "author": "the fix-storage authors",
  "main": "dist/main.js",
  "bin": {
    "shulker": "bin/shulker.cjs"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "tsc -p tsconfig.json && node bin/shulker.cjs",
    "demo": "tsc -p tsconfig.json && node bin/shulker.cjs --demo",
    "plain": "tsc -p tsconfig.json && node bin/shulker.cjs --plain",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build",
    "test": "npm run build && node --test test/*.test.cjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "cpu": [
    "arm64",
    "x64"
  ]
}
